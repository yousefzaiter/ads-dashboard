# =============================================================================
# Ads Dashboard — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values. Never commit .env.

# -----------------------------------------------------------------------------
# Authentication / Session
# -----------------------------------------------------------------------------
# Admin login (replaces the previous hardcoded admin in users.py).
# Generate the bcrypt hash with:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Session token lifetime in seconds (default 12 hours = 43200).
SESSION_TTL_SECONDS=43200

# -----------------------------------------------------------------------------
# Google Ads — required for the dashboard
# -----------------------------------------------------------------------------
# OAuth client credentials (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token from OAuth Playground (scope: https://www.googleapis.com/auth/adwords)
GOOGLE_ADS_REFRESH_TOKEN=

# Developer Token (from Google Ads → Tools → API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=

# Manager Account ID (MCC). Format: XXX-XXX-XXXX or XXXXXXXXXX
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Root customer ID used as fallback (10-digit, no dashes)
GOOGLE_ADS_CUSTOMER_ID=

# Optional: only needed by the standalone MCP server in test_google_ads_mcp.py
# GOOGLE_ADS_AUTH_TYPE=oauth
# GOOGLE_ADS_CREDENTIALS_PATH=/path/to/credentials.json
# GOOGLE_ADS_IMPERSONATION_EMAIL=

# -----------------------------------------------------------------------------
# Meta (Facebook / Instagram) Ads
# -----------------------------------------------------------------------------
# Long-lived user access token or System User token
META_ACCESS_TOKEN=
# App credentials — required for /debug_token validation and auto-refresh
META_APP_ID=
META_APP_SECRET=

# -----------------------------------------------------------------------------
# Snapchat Ads
# -----------------------------------------------------------------------------
# Get these from https://kit.snapchat.com/portal
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_REDIRECT_URI=https://ads-dashboard.yousefzaiter.com
# Tokens are filled in automatically by `python3 snap_auth.py`
SNAP_ACCESS_TOKEN=
SNAP_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# TikTok Ads
# -----------------------------------------------------------------------------
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# -----------------------------------------------------------------------------
# Campaign Creator (uses Anthropic Claude API)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Currency
# -----------------------------------------------------------------------------
# Override the USD → SAR conversion rate. Defaults to 3.75 if unset.
USD_TO_SAR=3.75
